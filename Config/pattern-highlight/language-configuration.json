{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(DEFINE|SOCKET|TIMING|BEGIN)\\b",
      "end": "^\\s*END\\b"
    }
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^`~!@%\\^&*()=+[{\\]}\\\\|;:'\",.<>/?\\s]+)"
}
