{
  "name": "pattern-highlight",
  "displayName": "Pattern Highlight",
  "description": "Syntax highlighting for the custom PAT pattern language.",
  "version": "0.1.9",
  "publisher": "seagull",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pattern",
        "aliases": [
          "PAT",
          "Pattern",
          "pattern"
        ],
        "extensions": [
          ".pat"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pattern",
        "scopeName": "source.pattern",
        "path": "./syntaxes/pattern.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "pattern",
        "path": "./snippets/pattern.code-snippets"
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": [
              "constant.language.pattern"
            ],
            "settings": {
              "foreground": "#d4995b",
              "fontStyle": "underline"
            }
          },
          {
            "scope": [
              "constant.numeric.pattern",
              "constant.numeric.hex.pattern",
              "constant.numeric.decimal.pattern"
            ],
            "settings": {
              "foreground": "#deae01"
            }
          },
          {
            "scope": [
              "entity.name.type.pattern"
            ],
            "settings": {
              "foreground": "#45c364"
            }
          },
          {
            "scope": [
              "support.type.property-name.pattern"
            ],
            "settings": {
              "foreground": "#c678dd"
            }
          },
          {
            "scope": [
              "keyword.operator.arithmetic.pattern",
              "keyword.operator.assignment.pattern",
              "keyword.operator.pattern"
            ],
            "settings": {
              "foreground": "#45b4c3"
            }
          },
          {
            "scope": [
              "punctuation.terminator.statement.pattern",
              "punctuation.separator.colon.pattern",
              "punctuation.separator.pipe.pattern",
              "punctuation.definition.separator.pattern"
            ],
            "settings": {
              "foreground": "#BBBBBB"
            }
          },
          {
            "scope": [
              "keyword.control.pattern"
            ],
            "settings": {
              "foreground": "#D55FDE",
              "fontStyle": "italic bold"
            }
          },
          {
            "scope": [
              "entity.name.label.pattern"
            ],
            "settings": {
              "foreground": "#52ADF2"
            }
          },
          {
            "scope": [
              "punctuation.definition.label.hash.pattern"
            ],
            "settings": {
              "foreground": "#52ADF2"
            }
          },
          {
            "scope": [
              "keyword.testflow.pattern"
            ],
            "settings": {
              "foreground": "#e06c75"
            }
          },
          {
            "scope": [
              "meta.label.arrow.pattern"
            ],
            "settings": {
              "foreground": "#45b4c3"
            }
          }
        ]
      }
    }
  }
}
