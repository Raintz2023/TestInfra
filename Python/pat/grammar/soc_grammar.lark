?start: socket_def

socket_def: "SOCKET" pin_stmt+ "END"

pin_stmt: "PIN" NAME "=" pin_range "=" "[" NAME "]" value
pin_range: IO_KIND INT (":" INT)?

?value: HEX           -> hex_lit
      | INT           -> int_lit

IO_KIND: "I" | "O"
NAME: /[A-Za-z_][A-Za-z0-9_]*/
HEX: /0[xX][0-9a-fA-F]+/

%import common.INT
%import common.WS
%ignore WS
%ignore /\/\/[^\n]*/
