{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PAT Pattern",
  "scopeName": "source.pattern",
  "fileTypes": [
    "pat"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#top-level"
    },
    {
      "include": "#pattern-flow"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#definition-blocks"
    },
    {
      "include": "#timing-blocks"
    },
    {
      "include": "#voltage-blocks"
    },
    {
      "include": "#socket-blocks"
    },
    {
      "include": "#matrix"
    },
    {
      "include": "#commands"
    },
    {
      "include": "#assignments"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "meta.directive.voltage.pattern",
          "match": "^\\s*(VOLTAGE)\\s*(=)\\s*(VS[A-Z0-9_]*)\\s*$",
          "captures": {
            "1": { "name": "keyword.control.pattern" },
            "2": { "name": "keyword.operator.assignment.pattern" },
            "3": { "name": "constant.language.pattern" }
          }
        },
        {
          "name": "comment.line.double-slash.pattern",
          "match": "//.*$"
        },
        {
          "name": "comment.block.pattern",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.pattern"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.pattern"
            }
          }
        }
      ]
    },
    "top-level": {
      "patterns": [
        {
          "name": "meta.directive.use.pattern",
          "match": "^\\s*(USE|INCLUDE)\\b\\s+(\\S+)",
          "captures": {
            "1": {
              "name": "keyword.control.pattern"
            },
            "2": {
              "name": "string.unquoted.path.pattern"
            }
          }
        },
        {
          "name": "keyword.control.pattern",
          "match": "\\b(COMMAND|DEFINE|DEFAULT|SOCKET|TIMING|VOLTAGE|REGISTER|FUNCTION|ALIAS|BEGIN|END)\\b"
        }
      ]
    },
    "pattern-flow": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.pattern",
          "match": "->|<|>"
        },
        {
          "name": "keyword.testflow.pattern",
          "match": "\\b(START|STOP)\\b"
        },
        {
          "name": "entity.name.label.pattern",
          "match": "\\b[A-Z][A-Z0-9_]*\\b(?=\\s*->)"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "meta.label.definition.pattern",
          "match": "\\b([A-Z][A-Z0-9_]*)\\b\\s*(#)",
          "captures": {
            "1": {
              "name": "entity.name.label.pattern"
            },
            "2": {
              "name": "punctuation.definition.label.hash.pattern"
            }
          }
        },
        {
          "name": "meta.goto.pattern",
          "match": "\\b(GOTO-(?:\\d+|[A-Z][A-Z0-9_]*))\\b\\s+([A-Z][A-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.pattern"
            },
            "2": {
              "name": "entity.name.label.pattern"
            }
          }
        }
      ]
    },
    "definition-blocks": {
      "patterns": [
        {
          "name": "meta.command.definition.pattern",
          "begin": "^\\s*([A-Z][A-Z0-9_]*)\\s*(\\()(?=[^)]*\\)\\s*\\{)",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.pattern"
            },
            "2": {
              "name": "punctuation.definition.parameters.begin.pattern"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.parameters.end.pattern"
            }
          },
          "patterns": [
            {
              "name": "variable.parameter.pattern",
              "match": "\\b[a-z_][a-z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.comma.pattern",
              "match": ","
            }
          ]
        },
        {
          "name": "meta.pin.action.pattern",
          "match": "\\b(DRIVE|SAMPLE|PULSE)\\b\\s+([A-Z][A-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pattern"
            },
            "2": {
              "name": "variable.other.pin.pattern"
            }
          }
        },
        {
          "name": "keyword.control.pattern",
          "match": "\\b(DRIVE|SAMPLE|PULSE)\\b"
        },
        {
          "name": "entity.name.type.pattern",
          "match": "\\b(DELAY|DEQUE)\\b"
        }
      ]
    },
    "socket-blocks": {
      "patterns": [
        {
          "name": "meta.socket.entry.pattern",
          "begin": "^\\s*(IN|OUT|POWER)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.pattern"
            },
            "2": {
              "name": "variable.other.pin.pattern"
            },
            "3": {
              "name": "punctuation.section.braces.pattern"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.braces.pattern"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#constants"
            },
            {
              "name": "support.type.property-name.pattern",
              "match": "\\b(PIN|WAV|DEF|SUP)\\b(?=\\s*:)"
            },
            {
              "name": "constant.numeric.pattern",
              "match": "\\b(NRZ|RZ|RZZ|STB)\\b(?!\\s*:)"
            },
            {
              "name": "entity.name.tag.pattern",
              "match": "@[A-Za-z_][A-Za-z0-9_]*"
            },
            {
              "include": "#punctuation"
            }
          ]
        },
        {
          "name": "keyword.control.pattern",
          "match": "\\b(IN|OUT|POWER)\\b"
        },
        {
          "name": "support.type.property-name.pattern",
          "match": "\\b(PIN|WAV|DEF|SUP)\\b(?=\\s*:)"
        }
      ]
    },
    "timing-blocks": {
      "patterns": [
        {
          "name": "meta.physical.time.pattern",
          "match": "(-?[0-9]+(?:\\.[0-9]+)?)(PS|NS|US|MS|S)\\b",
          "captures": {
            "1": { "name": "constant.numeric.pattern" },
            "2": { "name": "support.type.unit.pattern" }
          }
        },
        {
          "name": "support.type.property-name.pattern",
          "match": "\\b(PRD|EDGE|EDGE_1|EDGE_2|BASE)\\b(?=\\s*:)"
        },
        {
          "name": "storage.type.pattern",
          "match": "\\b(NRZ|RZ|RZZ|STB)\\b(?=\\s*\\{)"
        },
        {
          "name": "constant.language.pattern",
          "match": "\\bTS[A-Z0-9_]*\\b"
        },
        {
          "name": "entity.name.tag.pattern",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "voltage-blocks": {
      "patterns": [
        {
          "name": "meta.physical.voltage.pattern",
          "match": "(-?[0-9]+(?:\\.[0-9]+)?)(UV|MV|V)\\b",
          "captures": {
            "1": { "name": "constant.numeric.pattern" },
            "2": { "name": "support.type.unit.pattern" }
          }
        },
        {
          "name": "support.type.property-name.pattern",
          "match": "\\b(VIL|VIH|VOL|VOH|VDC)\\b(?=\\s*:)"
        },
        {
          "name": "storage.type.pattern",
          "match": "\\b(VIN|VOUT)\\b(?=\\s*\\{)"
        },
        {
          "name": "constant.language.pattern",
          "match": "\\bVS[A-Z0-9_]*\\b"
        },
        {
          "name": "entity.name.tag.pattern",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "matrix": {
      "patterns": [
        {
          "name": "punctuation.definition.separator.pattern",
          "match": "^\\s*-{5,}\\s*$"
        },
        {
          "name": "keyword.control.pattern",
          "match": "\\b(CTRL|NOP|RTN|FOR-(?:\\d+|[A-Z][A-Z0-9_]*)|GOTO-(?:\\d+|[A-Z][A-Z0-9_]*))\\b"
        },
        {
          "name": "entity.name.type.pattern",
          "match": "\\b(REG|ADDR|DATA|DELAY|[A-Z][A-Z0-9_]*(?=\\s*=))\\b"
        },
        {
          "name": "constant.language.pattern",
          "match": "\\b(CPA|CPL|CCR|ALERT|POP|TS[A-Z0-9_]*)\\b"
        }
      ]
    },
    "commands": {
      "patterns": [
        {
          "name": "meta.command.call.head.pattern",
          "match": "\\b([A-Z][A-Z0-9_]*)\\b(?=\\s*<)",
          "captures": {
            "1": {
              "name": "constant.language.pattern"
            }
          }
        },
        {
          "name": "support.function.pattern",
          "match": "\\b(CPA|CPL|CCR|ALERT|POP|TS[A-Z0-9_]*)\\b"
        }
      ]
    },
    "assignments": {
      "patterns": [
        {
          "name": "meta.assignment.pattern",
          "match": "\\b([A-Z][A-Z0-9_]*)\\b\\s*(=)",
          "captures": {
            "1": {
              "name": "entity.name.type.pattern"
            },
            "2": {
              "name": "keyword.operator.assignment.pattern"
            }
          }
        },
        {
          "name": "entity.name.type.pattern",
          "match": "\\b[A-Z][A-Z0-9_]*\\b"
        },
        {
          "name": "variable.parameter.pattern",
          "match": "\\b[a-z_][a-z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.numeric.hex.pattern",
          "match": "\\b0[xX][0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.decimal.pattern",
          "match": "(?<![A-Za-z0-9_])-?\\b\\d+\\b"
        },
        {
          "name": "constant.language.boolean.pattern",
          "match": "\\b(true|false|TRUE|FALSE)\\b"
        },
        {
          "name": "constant.language.pattern",
          "match": "\\b[X-Z]\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.pattern",
          "match": "->|<|>|\\+|-|\\*|/"
        },
        {
          "name": "keyword.operator.assignment.pattern",
          "match": "="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.pipe.pattern",
          "match": "\\|"
        },
        {
          "name": "punctuation.separator.colon.pattern",
          "match": ":"
        },
        {
          "name": "punctuation.terminator.statement.pattern",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.pattern",
          "match": ","
        },
        {
          "name": "punctuation.section.braces.pattern",
          "match": "[{}\\[\\]()]"
        }
      ]
    }
  }
}
