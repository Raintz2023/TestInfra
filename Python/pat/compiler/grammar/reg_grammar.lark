?start: assign
assign: NAME "=" expr

?expr: term
     | expr "+" term   -> add
     | expr "-" term   -> sub

?term: HEX           -> hex_lit
     | INT           -> int_lit
     | "/" NAME      -> invert_var
     | NAME          -> var

NAME: /[A-Z][A-Z0-9_]*/
HEX: /0[xX][0-9a-fA-F]+/
%import common.INT
%import common.WS
%ignore WS
