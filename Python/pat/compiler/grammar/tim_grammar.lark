?start: timing_block

timing_block: "TIMING" timing_set+ "END"
            | "TIMING" "{" timing_set+ "}"

timing_set: NAME "{" timing_item (","? timing_item)* ","? "}"

?timing_item: "PRD" ":" TIME_UINT -> period_spec
            | nrz_block
            | rz_block
            | rzz_block
            | stb_block

nrz_block: "NRZ" "{" nrz_content "}"
rz_block: "RZ" "{" rz_content "}"
rzz_block: "RZZ" "{" rzz_content "}"
stb_block: "STB" "{" stb_content "}"

?nrz_content: single_edge_field_list
            | nrz_variant_list
?stb_content: single_edge_field_list
            | stb_variant_list
?rz_content: two_edge_field_list
           | rz_variant_list
?rzz_content: two_edge_field_list
            | rzz_variant_list

single_edge_field_list: nrz_field ("," nrz_field)* ","?
two_edge_field_list: rz_field ("," rz_field)* ","?

nrz_variant_list: single_edge_variant (","? single_edge_variant)* ","?
stb_variant_list: single_edge_variant (","? single_edge_variant)* ","?
rz_variant_list: two_edge_variant (","? two_edge_variant)* ","?
rzz_variant_list: two_edge_variant (","? two_edge_variant)* ","?

single_edge_variant: VARIANT_NAME "{" single_edge_field_list "}"
two_edge_variant: VARIANT_NAME "{" two_edge_field_list "}"

?nrz_field: "EDGE" ":" time_uint -> edge_spec
          | "BASE" ":" time_sint -> base_spec

?rz_field: "EDGE_1" ":" time_uint -> edge_1_spec
         | "EDGE_2" ":" time_uint -> edge_2_spec
         | "BASE" ":" time_sint   -> base_spec

?rzz_field: "EDGE_1" ":" time_uint -> edge_1_spec
          | "EDGE_2" ":" time_uint -> edge_2_spec
          | "BASE" ":" time_sint   -> base_spec

?stb_field: "EDGE" ":" time_uint -> edge_spec
          | "BASE" ":" time_sint -> base_spec

?time_uint: TIME_UINT -> absolute_time
          | RATIO_UINT -> period_ratio
?time_sint: TIME_SINT -> absolute_time
          | RATIO_SINT -> period_ratio

NAME: /[A-Z][A-Z0-9_]*/
VARIANT_NAME: /@[A-Za-z_][A-Za-z0-9_]*/
TIME_UINT: /[0-9]+(?:\.[0-9]+)?(?:PS|NS|US|MS|S)/
TIME_SINT: /-?[0-9]+(?:\.[0-9]+)?(?:PS|NS|US|MS|S)/
RATIO_UINT: /[0-9]+(?:\.[0-9]+)?/
RATIO_SINT: /-?[0-9]+(?:\.[0-9]+)?/

%import common.WS
%ignore WS
%ignore /\/\/[^\n]*/
