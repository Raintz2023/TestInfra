{
  "version": 4,
  "configurations": [
    {
      "name": "WSL-Verilator",
      "compilerPath": "/usr/bin/g++",
      "intelliSenseMode": "linux-gcc-x64",
      "cStandard": "c11",
      "cppStandard": "c++20",
      "includePath": [
        "${workspaceFolder}/**",

        // Verilator 官方头文件
        "/usr/share/verilator/include",

        // Verilator 生成的 DUT 头文件
        "${workspaceFolder}/Verilog/obj_dir",

        "/root/Code/TestInfra/C++/include",

        "/usr/local/lib/python3.13/site-packages/pybind11/include",
        
        "/usr/include/python3.13"

      ]
    }
  ]
}