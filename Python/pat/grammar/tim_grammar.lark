?start: timing_set

timing_set: "SET" NAME "=" phase_spec+

?phase_spec: period_spec
           | nrz_spec
           | rzz_spec
           | stb_spec

period_spec: "[" "PRD" INT "]"
nrz_spec: "[" "NRZ" INT "]"
rzz_spec: "[" "RZZ" INT INT "]"
stb_spec: "[" "STB" INT "]"

NAME: /[A-Z][A-Z0-9_]*/

%import common.INT
%import common.WS
%ignore WS
