{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(COMMAND|DEFINE|SOCKET|TIMING|VOLTAGE|REGISTER|FUNCTION|BEGIN)\\b.*(?:\\{|$)",
      "end": "^\\s*(END|\\})\\s*$"
    }
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^`~!@%\\^&*()=+[{\\]}\\\\|;:'\",.<>/?\\s]+)"
}
