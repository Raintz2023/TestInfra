?start: stmt+

?stmt: labeled_ctrl
    | ctrl

labeled_ctrl: LABEL "#" ctrl

?ctrl: nop
    | for_
    | goto
    | rtn

nop: "NOP"
rtn: "RTN"
for_: FOR_COUNT
goto: GOTO_COUNT LABEL

FOR_COUNT: /FOR-(\d+|[A-Z][A-Z0-9_]*)/
GOTO_COUNT: /GOTO-(\d+|[A-Z][A-Z0-9_]*)/

LABEL: /[A-Z][A-Z0-9_]*/

%import common.INT
%import common.WS
%ignore WS
